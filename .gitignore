# OpenTofu / Terraform working directories
.terraform/
**/.terraform/

# State files
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# CLI and override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files that commonly contain secrets
*.tfvars
*.tfvars.json

# Local plan output
*.tfplan

# Local backend configuration generated from examples
infrastructure/aws/backend.tf
infrastructure/aws/backend.hcl
infrastructure/aws/bootstrap/backend.tf
infrastructure/aws/bootstrap/backend.hcl
infrastructure/aws/identity/backend.tf
infrastructure/aws/identity/backend.hcl

# OpenTofu-specific state backup artifacts
*.tofu.tfstate
*.tofu.tfstate.*

# opencode
.opencode

# pi
.pi
